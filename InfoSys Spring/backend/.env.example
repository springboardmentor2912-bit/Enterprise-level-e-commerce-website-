# ============================================================
# Obsidian Luxury - Backend Environment Template (.env.example)
# Copy this file to .env and adjust credentials as appropriate.
# ============================================================

# Server Port
SERVER_PORT=8080

# PostgreSQL Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/authdb
DB_USERNAME=postgres
DB_PASSWORD=your_db_password_here

# JWT Authentication
# Generate a strong 256-bit+ hex string for production
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION=86400000

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Razorpay Payment Gateway (Test or Live)
RAZORPAY_KEY_ID=rzp_test_5Xv8eZ4Q9X0123
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
RAZORPAY_CURRENCY=INR

# ShopStack Commission Settings
SHOPSTACK_COMMISSION_RATE=10.0
