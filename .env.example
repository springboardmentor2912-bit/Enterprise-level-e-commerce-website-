# ============================================================
# ShopStack Environment Variables — EXAMPLE FILE
# ============================================================
# Copy this file to .env and fill in REAL values.
# NEVER commit .env to Git.
#
# cp .env.example .env
# ============================================================

# ── Database (Neon / any PostgreSQL) ──────────────────────────
# Neon format: jdbc:postgresql://<host>/<db>?sslmode=require
DB_URL=jdbc:postgresql://localhost:5432/shopstack_db
DB_USERNAME=postgres
DB_PASSWORD=your_db_password_here

# ── JWT ───────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET=replace_with_at_least_64_char_random_secret

# ── Razorpay ─────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# ── JavaMailSender (Gmail example) ───────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password_here
MAIL_FROM=noreply@shopstack.com
MAIL_ENABLED=true

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# After Vercel deploy, add your Vercel URL here:
# ALLOWED_ORIGINS=https://shopstack.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Frontend (Vercel build env var) ──────────────────────────
# After Render deploy, set this to your Render backend URL:
# VITE_API_URL=https://shopstack-backend.onrender.com/api
VITE_API_URL=http://localhost:8080/api
