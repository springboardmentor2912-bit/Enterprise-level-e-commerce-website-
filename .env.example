# ===================================================
# ShopStack Production Environment Variables Template
# Copy this file to .env and configure values before deployment
# ===================================================

# PostgreSQL Database Configuration
POSTGRES_DB=shopstack_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here

# Backend Configuration
APP_BACKEND_BASE_URL=http://13.48.47.35:8080
SHOPSTACK_COMMISSION_PERCENTAGE=10.0

# Razorpay Payment Gateway Credentials (Test Mode)
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Transactional Email (Gmail SMTP + App Password)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password_here
MAIL_FROM=your_email@gmail.com
